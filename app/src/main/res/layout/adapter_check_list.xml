<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp15"
        android:paddingRight="@dimen/dp15">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp30"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <com.android.theme.font.FontTextView
                android:id="@+id/item"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp30"
                android:layout_weight="0.9"
                android:gravity=""
                android:padding="@dimen/dp4"
                android:text="santhana"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp25"
                android:layout_gravity="center"
                android:layout_weight=".1"
                android:gravity="center">

                <ImageView
                    android:id="@+id/checkboxImageView"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="@dimen/dp25"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/dp2"
                    android:padding="@dimen/dp3" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/checkListLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp50"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/oneLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/oneImageView"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:padding="@dimen/dp4"
                app:srcCompat="@drawable/ic_selected" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp10">

                <com.android.theme.font.FontTextView
                    android:id="@+id/oneText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/twoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/twoImageView"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:padding="@dimen/dp4"
                app:srcCompat="@drawable/ic_selected" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp10">

                <com.android.theme.font.FontTextView
                    android:id="@+id/twoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/threeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/threeImageView"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:padding="@dimen/dp4"
                app:srcCompat="@drawable/ic_selected" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp10">

                <com.android.theme.font.FontTextView
                    android:id="@+id/threeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fourLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/fourImageView"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:padding="@dimen/dp4"
                app:srcCompat="@drawable/ic_selected" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp10">

                <com.android.theme.font.FontTextView
                    android:id="@+id/fourText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fiveLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/fiveImageView"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:padding="@dimen/dp4"
                app:srcCompat="@drawable/ic_selected" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp10">

                <com.android.theme.font.FontTextView
                    android:id="@+id/fiveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/colorPrimary" />


            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp10"
        android:background="@color/text_color" />

</LinearLayout>
