<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:padding="15dp"
    android:orientation="vertical">

    <ImageView
        android:layout_width="180dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:src="@drawable/sdrive_login_logo" />


    <com.android.theme.font.FontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="7dp"
        android:layout_marginTop="@dimen/dp30"
        android:text="@string/new_version_launched"
        android:textColor="@color/colorPrimary"
        android:textSize="22sp" />

    <com.android.theme.font.FontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="7dp"
        android:text="@string/latest_version"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp" />




    <com.android.theme.font.FontButton
        android:id="@+id/btn_update"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/buttonprimaryeffect"
        android:text="@string/update_button"
        android:layout_marginTop="@dimen/dp30"
        android:textAllCaps="false"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginRight="@dimen/dp20"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <com.android.theme.font.FontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/skip"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:padding="7dp"
        android:text="@string/updateSkip"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp" />


</LinearLayout>
