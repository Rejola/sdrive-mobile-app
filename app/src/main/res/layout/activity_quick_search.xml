<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">
    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/addBookingMargin"
            android:background="@drawable/edittextbggray">
            <Spinner
                android:id="@+id/qsmake"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@null"
                android:paddingLeft="@dimen/dp2"
                android:textAlignment="center"
                android:textColor="@color/drop_down_color" />

            <ImageView
                android:layout_width="@dimen/dp10"
                android:layout_height="@dimen/dp10"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="@dimen/dp20"
                android:src="@android:drawable/arrow_down_float"
                android:tint="@color/colorPrimary" />
        </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/addBookingMargin"
        android:background="@drawable/edittextbggray">

        <Spinner
            android:id="@+id/qsmodel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@null"
            android:paddingLeft="@dimen/dp2"
            android:textAlignment="center"
            android:textColor="@color/drop_down_color"
            tools:ignore="DuplicateIds" />

        <ImageView
            android:layout_width="@dimen/dp10"
            android:layout_height="@dimen/dp10"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="@dimen/dp20"
            android:src="@android:drawable/arrow_down_float"
            android:tint="@color/colorPrimary" />

    </FrameLayout>

            <AutoCompleteTextView
                android:id="@+id/searchSpareAutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/edittextbggray"
                android:hint="Search Spares"
                android:maxLines="1"
                android:clickable="true"
                android:paddingLeft="@dimen/dp10"
                android:textColor="@color/black"
                android:textColorHint="@color/text777"
                android:textSize="@dimen/sp16" />


            <AutoCompleteTextView
                android:id="@+id/searchLabourAutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/dp5"
                android:background="@drawable/edittextbggray"
                android:hint="Search Labour"
                android:maxLines="1"
                android:clickable="true"
                android:paddingLeft="@dimen/dp10"
                android:textColor="@color/black"
                android:textColorHint="@color/text777"
                android:textSize="@dimen/sp16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/addSpareLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp5"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:background="@drawable/ic_spares" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:text="@string/spares"
                            android:textColor="@color/textDark"
                            android:textSize="@dimen/sp18" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/text_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/spareRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/addLabourLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp5"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:background="@drawable/ic_labour" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:text="@string/labours"
                            android:textColor="@color/textDark"
                            android:textSize="@dimen/sp18" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/text_color" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/labourRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/totalLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:background="@color/app_bg"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/labourSubCost"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/labourCostTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cGST"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/labourCGSTTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sGST"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/labourSGSTTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/spareSubCost"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/spareCostTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cGST"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/spareCGSTTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sGST"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/spareSGSTTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp14" />


                    </LinearLayout>


                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp1"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:background="@color/app_bg" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp30"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/totalCost"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16" />


                        <com.android.theme.font.FontTextView
                            android:id="@+id/totalCostTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="Rs 150"
                            android:textColor="@android:color/holo_red_dark"
                            android:textSize="@dimen/sp16"
                            app:fontPath="@string/typeface_bold"/>


                    </LinearLayout>

                </LinearLayout>

                <com.android.theme.font.FontTextView
                    android:id="@+id/addSpareAndLabour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/addSpareLabour"
                    android:visibility="visible"
                    android:gravity="center"/>


            </LinearLayout>



        </LinearLayout>


    </android.support.v4.widget.NestedScrollView>
    <com.android.theme.font.FontTextView
        android:id="@+id/noResultFound"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_results_found"
        android:visibility="gone" />
</LinearLayout>
