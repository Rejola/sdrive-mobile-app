<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/remainderLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <android.support.v4.widget.SwipeRefreshLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/swipeRefreshLayout">

            <android.support.v7.widget.RecyclerView
                android:id="@+id/remainderRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="5dp" />

        </android.support.v4.widget.SwipeRefreshLayout>





        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


    </LinearLayout>

    <com.android.theme.font.FontTextView
        android:id="@+id/noResultFound"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="@string/no_results_found"
        android:textColor="@color/text444"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/noReminderLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:gravity="center"
            android:src="@drawable/no_reminder"
            android:visibility="visible" />

        <com.android.theme.font.FontTextView
            android:id="@+id/noReminderFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp15"
            android:gravity="center"
            android:text="No Reminders Found"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/sp16" />


        <com.android.theme.font.FontButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:background="@drawable/buttonprimaryeffect"
            android:text="@string/retry"
            android:clickable="true"
            android:layout_marginTop="@dimen/dp10"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp14"
            android:visibility="gone" />


    </LinearLayout>



    <LinearLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <com.android.theme.activity.AVLoadingIndicatorView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginRight="20dp"
            app:indicator_color="@color/colorPrimary" />

        <com.android.theme.font.FontTextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Loading ... "
            android:textColor="@color/colorPrimary"
            android:textSize="15dp" />
    </LinearLayout>


    <ImageView
        android:id="@+id/addButton"
        android:layout_width="@dimen/dp55"
        android:layout_height="@dimen/dp55"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:padding="@dimen/dp7"
        android:visibility="gone"
        app:backgroundTint="@color/colorPrimary"
        app:srcCompat="@drawable/ic_add_button" />

</RelativeLayout>
