<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:theme="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:ignore="MissingPrefix">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:visibility="visible">


        <LinearLayout
            android:layout_width="0px"
            android:layout_height="0px"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <include
            layout="@layout/toolbar_header"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin" />


        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <com.android.theme.font.FontTextView
                    android:id="@+id/noInternetConnection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/title_of_data_message"
                    android:textColor="@color/colorPrimary"
                    android:visibility="gone" />


                <LinearLayout
                    android:id="@+id/progressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <com.android.theme.activity.AVLoadingIndicatorView xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginRight="20dp"
                        app:indicator_color="@color/colorPrimary" />

                    <com.android.theme.font.FontTextView
                        android:id="@+id/message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="Loading ... "
                        android:textColor="@color/colorPrimary"
                        android:textSize="15dp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/homeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- <view
                         android:layout_width="wrap_content"
                         android:layout_marginRight="@dimen/dp10"
                         android:background="@color/transparen"
                         android:layout_height="0dp"/>-->

                    <!--<View android:background="#ffffff"-->
                    <!--android:layout_width = "match_parent"-->
                    <!--android:layout_height="1dp"/>-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorPrimary"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp80"
                            android:layout_weight="1"
                            android:background="@color/colorPrimary"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:id="@+id/reminderTodayLayout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5"
                                android:background="@drawable/ripple_effect"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp10"
                                    android:layout_weight=".5"
                                    android:orientation="horizontal"
                                    android:padding="@dimen/dp5">


                                    <ImageView
                                        android:layout_width="@dimen/dp40"
                                        android:layout_height="@dimen/dp40"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginLeft="@dimen/dp5"
                                        android:background="@drawable/ic_reminder_today" />


                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/dp5"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:gravity="left"
                                        android:orientation="vertical">

                                        <com.android.theme.font.FontTextView
                                            android:id="@+id/reminderCountTextView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:text="0"
                                            android:textColor="@color/white"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />


                                        <com.android.theme.font.FontTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:maxLines="2"
                                            android:minLines="2"
                                            android:text="@string/reminderToday"
                                            android:textColor="@color/white"
                                            android:textSize="13sp" />


                                    </LinearLayout>
                                </LinearLayout>


                            </LinearLayout>


                            <View
                                android:layout_width="1dp"
                                android:layout_height="@dimen/dp50"
                                android:background="@color/dividerColor" />

                            <LinearLayout
                                android:id="@+id/leadsLayout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5"
                                android:background="@drawable/ripple_effect"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp10"
                                    android:layout_weight=".5"
                                    android:orientation="horizontal"
                                    android:padding="@dimen/dp5">


                                    <ImageView
                                        android:layout_width="@dimen/dp40"
                                        android:layout_height="@dimen/dp40"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginLeft="@dimen/dp5"
                                        android:background="@drawable/ic_lead" />


                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/dp5"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:gravity="left"
                                        android:orientation="vertical">

                                        <com.android.theme.font.FontTextView
                                            android:id="@+id/leadsCountTextView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:text="0"
                                            android:textColor="@color/white"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />


                                        <com.android.theme.font.FontTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:maxLines="2"
                                            android:minLines="2"
                                            android:text="@string/HomeLeads"
                                            android:textColor="@color/white"
                                            android:textSize="13sp" />


                                    </LinearLayout>
                                </LinearLayout>


                            </LinearLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/colorPrimary"
                            android:orientation="horizontal"
                            android:weightSum="1">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginLeft="@dimen/dp4"
                                android:layout_marginRight="@dimen/dp20"
                                android:layout_weight=".5"
                                android:background="@color/dividerColor" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginLeft="@dimen/dp20"
                                android:layout_marginRight="@dimen/dp4"
                                android:layout_weight=".5"
                                android:background="@color/dividerColor" />


                        </LinearLayout>


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp80"
                            android:layout_weight="1"
                            android:background="@color/colorPrimary"
                            android:orientation="horizontal">


                            <LinearLayout
                                android:id="@+id/avgRatingLayout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5"
                                android:background="@drawable/ripple_effect"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp10"
                                    android:layout_weight=".5"
                                    android:orientation="horizontal"
                                    android:padding="@dimen/dp5">


                                    <ImageView
                                        android:layout_width="@dimen/dp40"
                                        android:layout_height="@dimen/dp40"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginLeft="@dimen/dp5"
                                        android:background="@drawable/ic_avg_rating" />


                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/dp5"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:gravity="left"
                                        android:orientation="vertical">

                                        <com.android.theme.font.FontTextView
                                            android:id="@+id/ratingTextView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:text="0"
                                            android:textColor="@color/white"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />


                                        <com.android.theme.font.FontTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:maxLines="2"
                                            android:minLines="2"
                                            android:text="@string/HomeRating"
                                            android:textColor="@color/white"
                                            android:textSize="13sp" />


                                    </LinearLayout>
                                </LinearLayout>


                            </LinearLayout>


                            <View
                                android:layout_width="1dp"
                                android:layout_height="@dimen/dp50"
                                android:layout_marginTop="@dimen/dp15"
                                android:background="@color/dividerColor" />


                            <LinearLayout
                                android:id="@+id/completedLayout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight=".5"
                                android:background="@drawable/ripple_effect"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp10"
                                    android:layout_weight=".5"
                                    android:orientation="horizontal"
                                    android:padding="@dimen/dp5">


                                    <ImageView
                                        android:layout_width="@dimen/dp40"
                                        android:layout_height="@dimen/dp40"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginLeft="@dimen/dp5"
                                        android:background="@drawable/ic_completed" />


                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="@dimen/dp5"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:gravity="left"
                                        android:orientation="vertical">

                                        <com.android.theme.font.FontTextView
                                            android:id="@+id/completedCountTextView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:text="0"
                                            android:textColor="@color/white"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />


                                        <com.android.theme.font.FontTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp5"
                                            android:maxLines="2"
                                            android:minLines="2"
                                            android:text="@string/HomeCompleted"
                                            android:textColor="@color/white"
                                            android:textSize="13sp" />


                                    </LinearLayout>
                                </LinearLayout>


                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"

                        android:orientation="vertical">

                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/homeRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp5"
                            android:layout_marginBottom="@dimen/dp5"
                            android:visibility="gone" />


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/addNewBookingLayout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp45"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/dp20"
                        android:layout_marginTop="@dimen/dp20"
                        android:layout_marginRight="@dimen/dp20"
                        android:background="@drawable/buttonprimaryeffect"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/ic_newbooking" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            android:paddingLeft="@dimen/dp5"
                            android:text="@string/newBooking"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp" />





                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>

        </android.support.v4.widget.NestedScrollView>


    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="start"
        android:background="@color/white">


        <ListView
            android:id="@+id/navListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/logoutRelativeLayout"
            android:layout_alignParentRight="true"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="false"
            android:scrollIndicators="none"
            android:scrollbars="none" />


        <RelativeLayout
            android:id="@+id/logoutRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/ripple_effect"
            android:gravity="right|center">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginRight="@dimen/dp30"
                android:layout_marginBottom="@dimen/dp10"
                android:gravity="right"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_logout" />

                <com.android.theme.font.FontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp25"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp7"
                    android:gravity="center_vertical"
                    android:text="Logout"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp" />


            </LinearLayout>


        </RelativeLayout>
    </RelativeLayout>


</android.support.v4.widget.DrawerLayout>