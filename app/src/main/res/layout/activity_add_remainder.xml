<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_customer_details" />

                    <com.android.theme.font.FontTextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp25"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp3"
                        android:gravity="center_vertical"
                        android:text="@string/customerDetails"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp10"
                    android:paddingLeft="@dimen/sp20"
                    android:paddingRight="@dimen/sp20">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edittextbggray"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/dp10"
                            android:text="+91" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/dp5"
                            android:layout_marginTop="7dp"
                            android:layout_marginRight="@dimen/dp5"
                            android:layout_marginBottom="7dp"
                            android:background="@color/text_color" />


                        <com.android.theme.font.FontEdittext
                            android:id="@+id/customerNo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/customerNo"
                            android:inputType="number"
                            android:maxLength="10"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />



                    </LinearLayout>




                    <com.android.theme.font.FontEdittext
                        android:id="@+id/customerName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:background="@drawable/edittextbggray"
                        android:hint="@string/customerName"
                        android:maxLines="1"
                        android:paddingTop="@dimen/dp2"

                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                        android:inputType="textCapWords"
                        android:padding="10dp"
                        android:textColorHint="@color/text_color"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>



            </LinearLayout>
        </android.support.v7.widget.CardView>


        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_vehicle_details"/>

                    <com.android.theme.font.FontTextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp25"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp3"

                        android:gravity="center_vertical"
                        android:text="@string/vehicleDetails"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginRight="@dimen/sp20"
                    android:layout_marginLeft="@dimen/sp20">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:background="@drawable/edittextbggray">

                        <Spinner
                            android:id="@+id/serviceSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:background="@null"
                            android:paddingLeft="@dimen/dp2"
                            android:spinnerMode="dropdown"
                            android:textAlignment="center"
                            android:textColor="@color/drop_down_color" />

                        <ImageView
                            android:layout_width="@dimen/dp10"
                            android:layout_height="@dimen/dp10"
                            android:layout_gravity="right|center_vertical"
                            android:layout_marginRight="@dimen/dp20"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="@color/colorPrimary" />


                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:background="@drawable/edittextbggray"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.5">

                            <com.android.theme.font.FontEdittext
                                android:id="@+id/stateCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="TN"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:maxLength="2"
                                android:maxLines="1"
                                android:textColorHint="@color/text_color"
                                android:nextFocusForward="@+id/areaCode"
                                android:singleLine="true"
                                android:textAllCaps="true" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="5dp"
                            android:layout_marginTop="5dp"
                            android:background="@color/text555" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.5">

                            <com.android.theme.font.FontEdittext
                                android:id="@+id/areaCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="01"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="2"
                                android:maxLines="1"
                                android:textColorHint="@color/text_color"

                                android:nextFocusForward="@+id/serialText"
                                android:singleLine="true" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="5dp"
                            android:layout_marginTop="5dp"
                            android:background="@color/text555" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.5">

                            <com.android.theme.font.FontEdittext
                                android:id="@+id/serialText"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="AB"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:maxLength="2"
                                android:maxLines="1"
                                android:textColorHint="@color/text_color"

                                android:nextFocusForward="@+id/serialNo"
                                android:singleLine="true"
                                android:textAllCaps="true" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="5dp"
                            android:layout_marginTop="5dp"
                            android:background="@color/text555" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.5">

                            <com.android.theme.font.FontEdittext
                                android:id="@+id/serialNo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:gravity="center"
                                android:hint="1111"
                                android:inputType="number"
                                android:maxLength="4"
                                android:maxLines="1"
                                android:textColorHint="@color/text_color"
                                android:singleLine="true" />
                        </LinearLayout>

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:background="@drawable/edittextbggray">


                        <Spinner
                            android:id="@+id/makeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@null"
                            android:paddingLeft="@dimen/dp2"
                            android:textAlignment="center"
                            android:textColor="@color/drop_down_color" />

                        <ImageView
                            android:layout_width="@dimen/dp10"
                            android:layout_height="@dimen/dp10"
                            android:layout_gravity="right|center_vertical"
                            android:layout_marginRight="@dimen/dp20"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="@color/colorPrimary" />

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/dp10"
                        android:background="@drawable/edittextbggray">

                        <Spinner
                            android:id="@+id/modalSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@null"
                            android:paddingLeft="@dimen/dp2"
                            android:textAlignment="center"
                            android:textColor="@color/drop_down_color" />

                        <ImageView
                            android:layout_width="@dimen/dp10"
                            android:layout_height="@dimen/dp10"
                            android:layout_gravity="right|center_vertical"
                            android:layout_marginRight="@dimen/dp20"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="@color/colorPrimary" />


                    </FrameLayout>


                    <com.android.theme.font.FontEdittext
                        android:id="@+id/serviceDate"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:background="@drawable/edittextbggray"
                        android:hint="@string/followUpDateR"
                        android:inputType="none"
                        android:paddingLeft="@dimen/dp10"
                        android:maxLines="1"
                        android:textColorHint="@color/text_color"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </LinearLayout>



            </LinearLayout>
        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/dp15"
                        android:layout_height="@dimen/dp20"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_description" />

                    <com.android.theme.font.FontTextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp25"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp3"
                        android:gravity="center_vertical"
                        android:text="@string/descriptionDetails"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp" />


                </LinearLayout>



                <com.android.theme.font.FontEdittext
                    android:id="@+id/descEditText"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/addBookingMargin"

                    android:background="@drawable/edittextbggray"
                    android:gravity="top"
                    android:hint="@string/description"
                    android:layout_marginLeft="@dimen/dp20"
                    android:minHeight="80dp"
                    android:maxLength="1000"
                    android:layout_marginRight="@dimen/dp25"
                    android:inputType="textCapWords"
                    android:padding="10dp"
                    android:textColorHint="@color/text_color"
                    android:textSize="14sp" />

                <com.android.theme.font.FontButton
                    android:id="@+id/BookButton"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/buttonprimaryeffect"
                    android:text="@string/addRemainder"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </android.support.v7.widget.CardView>
    </LinearLayout>

</ScrollView>
