<?xml version="1.0" encoding="utf-8"?>


<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">


    <LinearLayout
        android:id="@+id/detailsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/spareLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <com.android.theme.font.FontTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/spareLabour"
                        android:textColor="@color/textDark"
                        android:textSize="@dimen/sp18" />


                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/spareRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/labourLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <com.android.theme.font.FontTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/labour"
                        android:textColor="@color/textDark"
                        android:textSize="@dimen/sp18" />


                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/labourRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:gravity="center"
            android:orientation="vertical">


            <com.android.theme.font.FontTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10sp"
                android:gravity="center"
                android:text="@string/estimateBillAmount"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp" />

            <com.android.theme.font.FontEdittext
                android:id="@+id/totalEditText"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/edittextbggray"
                android:hint="@string/estimateAmt"
                android:inputType="number"
                android:padding="7dp" />


            <com.android.theme.font.FontButton
                android:id="@+id/updateButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dp10"
                android:background="@drawable/buttonprimaryeffect"
                android:text="@string/update"
                android:textColor="@color/white" />


        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/noResultFound"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:text="@string/no_results_found"
        android:visibility="gone" />


</FrameLayout>
