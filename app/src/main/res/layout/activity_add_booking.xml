<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp10"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/ic_customer_details" />

                            <com.android.theme.font.FontTextView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp25"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/dp10"
                                android:gravity="center_vertical"
                                android:paddingTop="@dimen/dp5"
                                android:text="@string/customerDetails"
                                android:textColor="@color/colorPrimary"
                                android:textSize="16sp" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/dp10"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/dp20"
                            android:paddingRight="@dimen/dp20">
                            <LinearLayout
                                android:id="@+id/searchLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="@drawable/edittextbggray"
                                    android:orientation="horizontal">

                                    <!--<com.android.theme.font.FontTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingLeft="@dimen/dp10"
                                        android:text="+91" />

                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="@dimen/dp5"
                                        android:layout_marginTop="7dp"
                                        android:layout_marginRight="@dimen/dp5"
                                        android:layout_marginBottom="7dp"
                                        android:background="@color/text_color" />

    -->


                                    <com.android.theme.font.FontEdittext
                                        android:id="@+id/searchEditText"
                                        android:layout_width="313dp"
                                        android:layout_height="@dimen/dp40"
                                        android:layout_weight="1"
                                        android:background="@null"
                                        android:hint="@string/mobileVehicle"
                                        android:imeOptions="actionSearch"
                                        android:inputType="text"
                                        android:padding="@dimen/dp10"
                                        android:maxLines="1"
                                        android:singleLine="true"
                                        android:textColor="@color/text_color"
                                        android:textSize="14sp" />




                                    <android.support.v7.widget.AppCompatImageView
                                        android:id="@+id/searchIcon"
                                        android:layout_width="@dimen/dp15"
                                        android:layout_height="@dimen/dp15"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginRight="10dp"
                                        app:srcCompat="@drawable/ic_search" />

                                </LinearLayout>

                                <com.android.theme.font.FontTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp10"
                                    android:paddingLeft="@dimen/dp12"
                                    android:layout_marginTop="@dimen/dp2"
                                    android:hint="Ex : Enter 10 Digit Mobile No  or  TN/01/AB/1111"/>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="@dimen/dp10"
                                android:background="@drawable/edittextbggray"
                                android:orientation="horizontal">

                                <com.android.theme.font.FontTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingLeft="@dimen/dp10"
                                    android:text="+91" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="@dimen/dp5"
                                    android:layout_marginTop="7dp"
                                    android:layout_marginRight="@dimen/dp5"
                                    android:layout_marginBottom="7dp"
                                    android:background="@color/text_color" />


                                <com.android.theme.font.FontEdittext
                                    android:id="@+id/customerNo"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp40"
                                    android:layout_weight="1"
                                    android:background="@null"
                                    android:hint="@string/customerNo"
                                    android:inputType="number"
                                    android:maxLength="10"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:textColor="@color/text_color"
                                    android:textSize="14sp" />



                            </LinearLayout>






                            <com.android.theme.font.FontEdittext
                                android:id="@+id/customerName"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginTop="@dimen/addBookingMargin"
                                android:background="@drawable/edittextbggray"
                                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                                android:hint="@string/customerName"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:padding="10dp"
                                android:singleLine="true"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />


                            <com.android.theme.font.FontEdittext
                                android:id="@+id/emailEditText"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginTop="@dimen/addBookingMargin"
                                android:background="@drawable/edittextbggray"
                                android:hint="@string/email"
                                android:inputType="textEmailAddress"
                                android:maxLines="1"
                                android:padding="10dp"
                                android:singleLine="true"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />

                            <com.android.theme.font.FontEdittext
                                android:id="@+id/addressEditText"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="@dimen/addBookingMargin"
                                android:layout_marginBottom="@dimen/dp5"
                                android:background="@drawable/edittextbggray"
                                android:gravity="top"
                                android:hint="@string/address"
                                android:inputType="textCapWords|text|textMultiLine"
                                android:maxLines="3"
                                android:nextFocusForward="@+id/stateCode"
                                android:padding="10dp"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>

            </LinearLayout>


            <android.support.v7.widget.CardView
                android:id="@+id/vehicleLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp10">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_vehicle_ready" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp25"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/dp10"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/dp5"
                            android:text="@string/chooseVehicle"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp" />


                    </LinearLayout>


                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/vehicleRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <android.support.v4.view.ViewPager
                        android:id="@+id/vehicleViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="215dp"
                        android:layout_margin="@dimen/dp10" />


                </LinearLayout>


            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_vehicle_details" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp25"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/dp10"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/dp5"
                            android:text="@string/vehicleDetails"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp20"
                        android:layout_marginRight="@dimen/dp20"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:background="@drawable/edittextbggray"
                            android:orientation="horizontal"
                            android:weightSum="10">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2.5">

                                <com.android.theme.font.FontEdittext
                                    android:id="@+id/stateCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:gravity="center"
                                    android:hint="TN"
                                    android:imeOptions="actionNext"
                                    android:inputType="textCapCharacters"
                                    android:maxLength="2"
                                    android:maxLines="1"
                                    android:nextFocusForward="@+id/areaCode"
                                    android:singleLine="true"
                                    android:textAllCaps="true"
                                    android:textColor="@color/text_color" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:background="@color/text_color" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2.5">

                                <com.android.theme.font.FontEdittext
                                    android:id="@+id/areaCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:gravity="center"
                                    android:hint="01"
                                    android:imeOptions="actionNext"
                                    android:inputType="number"
                                    android:maxLength="2"
                                    android:maxLines="1"
                                    android:nextFocusForward="@+id/serialText"
                                    android:singleLine="true"
                                    android:textColor="@color/text_color" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:background="@color/text_color" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2.5">

                                <com.android.theme.font.FontEdittext
                                    android:id="@+id/serialText"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:gravity="center"
                                    android:hint="AB"
                                    android:imeOptions="actionNext"
                                    android:inputType="textCapCharacters"
                                    android:maxLength="2"
                                    android:maxLines="1"
                                    android:nextFocusForward="@+id/serialNo"
                                    android:singleLine="true"
                                    android:textAllCaps="true"
                                    android:textColor="@color/text_color" />

                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="5dp"
                                android:background="@color/text_color" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2.5">

                                <com.android.theme.font.FontEdittext
                                    android:id="@+id/serialNo"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:gravity="center"
                                    android:hint="1111"
                                    android:inputType="number"
                                    android:maxLength="4"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:textColor="@color/text_color" />

                            </LinearLayout>

                        </LinearLayout>


                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:background="@drawable/edittextbggray">


                            <Spinner
                                android:id="@+id/makeSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp2"
                                android:textAlignment="center"
                                android:textColor="@color/drop_down_color" />

                            <ImageView
                                android:layout_width="@dimen/dp10"
                                android:layout_height="@dimen/dp10"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginRight="@dimen/dp20"
                                android:src="@android:drawable/arrow_down_float"
                                android:tint="@color/colorPrimary" />

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="@dimen/dp10"
                            android:background="@drawable/edittextbggray">

                            <Spinner
                                android:id="@+id/modalSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp2"
                                android:textAlignment="center"
                                android:textColor="@color/drop_down_color" />

                            <ImageView
                                android:layout_width="@dimen/dp10"
                                android:layout_height="@dimen/dp10"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginRight="@dimen/dp20"
                                android:src="@android:drawable/arrow_down_float"
                                android:tint="@color/colorPrimary" />


                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="@dimen/dp5"
                            android:background="@drawable/edittextbggray">

                            <Spinner
                                android:id="@+id/fuelSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp2"
                                android:spinnerMode="dropdown"
                                android:textAlignment="center"
                                android:textColor="@color/drop_down_color" />

                            <ImageView
                                android:layout_width="@dimen/dp10"
                                android:layout_height="@dimen/dp10"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginRight="@dimen/dp20"
                                android:src="@android:drawable/arrow_down_float"
                                android:tint="@color/colorPrimary" />


                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_services_details" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp25"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/dp10"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/dp5"
                            android:text="@string/serviceDetails"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/dp20"
                        android:paddingRight="@dimen/dp20">


                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:background="@drawable/edittextbggray">

                            <Spinner
                                android:id="@+id/serviceSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp40"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp2"
                                android:spinnerMode="dropdown"
                                android:textAlignment="center"
                                android:textColor="@color/drop_down_color" />

                            <ImageView
                                android:layout_width="@dimen/dp10"
                                android:layout_height="@dimen/dp10"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginRight="@dimen/dp20"
                                android:src="@android:drawable/arrow_down_float"
                                android:tint="@color/colorPrimary" />


                        </FrameLayout>


                        <com.android.theme.font.FontTextView
                            android:id="@+id/serviceDate"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:background="@drawable/edittextbggray"
                            android:hint="@string/serviceDate"
                            android:inputType="none"
                            android:maxLines="1"
                            android:padding="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />


                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:layout_marginBottom="@dimen/dp5"
                            android:background="@drawable/edittextbggray">

                            <Spinner
                                android:id="@+id/adviserSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp40"
                                android:background="@null"
                                android:paddingLeft="@dimen/dp2"
                                android:spinnerMode="dropdown"
                                android:textAlignment="center"
                                android:textColor="@color/drop_down_color" />

                            <ImageView
                                android:layout_width="@dimen/dp10"
                                android:layout_height="@dimen/dp10"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginRight="@dimen/dp20"
                                android:src="@android:drawable/arrow_down_float"
                                android:tint="@color/colorPrimary" />


                        </FrameLayout>


                    </LinearLayout>
                </LinearLayout>
            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="visible">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_vehicle_pickup" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp25"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/dp10"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/dp5"
                            android:text="@string/vehiclePickup"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp" />


                    </LinearLayout>


                    <RadioGroup
                        android:id="@+id/pickUpGroup"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginLeft="@dimen/dp35"
                        android:layout_marginTop="@dimen/addBookingMargin"
                        android:layout_marginRight="@dimen/dp35"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <!--  <LinearLayout
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="@dimen/dp10"
                              android:orientation="horizontal"
                              android:paddingLeft="@dimen/dp35">-->


                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text="@string/yes"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/sp16" />

                        <RadioButton
                            android:id="@+id/pickUp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:buttonTint="@color/colorPrimary"
                            android:paddingRight="@dimen/dp20"
                            android:scaleX="0.8"
                            android:scaleY="0.8" />


                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text="@string/no"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/sp16" />

                        <RadioButton

                            android:id="@+id/noPickUp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:buttonTint="@color/colorPrimary"
                            android:checked="true"
                            android:scaleX="0.8"
                            android:scaleY="0.8"

                            />


                    </RadioGroup>


                    <LinearLayout
                        android:id="@+id/pickUpLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/dp5"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/dp20"
                        android:paddingRight="@dimen/dp20"
                        android:visibility="gone">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:background="@drawable/edittextbggray">

                            <Spinner
                                android:id="@+id/pickUpSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp40"
                                android:backgroundTint="@color/colorPrimary"
                                android:dropDownSelector="@color/colorPrimary"
                                android:paddingLeft="@dimen/dp2"
                                android:spinnerMode="dropdown"
                                android:textAlignment="center" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <com.android.theme.font.FontTextView
                                android:id="@+id/pickUpDate"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginRight="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittextbggray"
                                android:hint="@string/pickUpDate"
                                android:inputType="none"
                                android:padding="10dp"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />

                            <com.android.theme.font.FontTextView
                                android:id="@+id/pickUpTime"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/edittextbggray"
                                android:hint="@string/pickUpTime"
                                android:inputType="none"
                                android:padding="10dp"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />


                        </LinearLayout>


                        <com.android.theme.font.FontEdittext
                            android:id="@+id/pickupAddressEditText"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp60"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:layout_marginBottom="@dimen/dp5"
                            android:background="@drawable/edittextbggray"
                            android:gravity="top"
                            android:hint="@string/pickupAddress"
                            android:inputType="textCapWords|text|textMultiLine"
                            android:maxLines="3"
                            android:nextFocusForward="@+id/stateCode"
                            android:padding="10dp"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />


                    </LinearLayout>

                </LinearLayout>
            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp15"
                            android:layout_height="@dimen/dp20"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_description" />

                        <com.android.theme.font.FontTextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp25"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/dp13"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/dp5"
                            android:text="@string/descriptionDetails"
                            android:textColor="@color/colorPrimary"
                            android:textSize="16sp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/dp20"
                        android:paddingRight="@dimen/dp20">

                        <com.android.theme.font.FontEdittext
                            android:id="@+id/descriptionEditText"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="@dimen/addBookingMargin"
                            android:layout_marginBottom="@dimen/dp5"
                            android:background="@drawable/edittextbggray"
                            android:gravity="top"
                            android:hint="@string/description"
                            android:inputType="textCapWords|text|textMultiLine"
                            android:maxLength="1000"
                            android:padding="10dp"
                            android:textColor="@color/text_color"
                            android:textSize="14sp" />


                    </LinearLayout>


                </LinearLayout>
            </android.support.v7.widget.CardView>


            <com.android.theme.font.FontButton
                android:id="@+id/BookButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp45"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginRight="@dimen/dp20"
                android:background="@drawable/buttonprimaryeffect"
                android:padding="@dimen/dp10"
                android:text="@string/create"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp16" />

        </LinearLayout>
    </LinearLayout>

</android.support.v4.widget.NestedScrollView>
