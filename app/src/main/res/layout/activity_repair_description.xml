<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/descriptionLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="visible"
        android:orientation="vertical">

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:orientation="vertical">


                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/cardRadius"
                    app:cardElevation="@dimen/cardElevation">

                    <LinearLayout
                        android:id="@+id/description1Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cardPadding">

                        <TextView
                            android:id="@+id/descriptionTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textLite"
                            android:textSize="@dimen/sp14" />

                    </LinearLayout>

                </android.support.v7.widget.CardView>




                <LinearLayout
                    android:id="@+id/addSpareLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/spareLabour"
                        android:textColor="@color/textDark"
                        android:textSize="@dimen/sp18" />



                </LinearLayout>


                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/cardRadius"
                    app:cardElevation="@dimen/cardElevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cardPadding">

                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/spareRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </android.support.v7.widget.CardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="right"
                    android:orientation="horizontal">



                    <Button
                        android:id="@+id/addSpareButton"
                        android:layout_width="80dp"
                        android:layout_height="25dp"
                        android:background="@drawable/buttonprimaryeffect"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="@dimen/dp5"
                        android:text="@string/addMore"
                        android:textSize="10sp"
                        android:textColor="@color/white" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/addLabourLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/labour"
                        android:textColor="@color/textDark"
                        android:textSize="@dimen/sp18" />




                </LinearLayout>


                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/cardRadius"
                    app:cardElevation="@dimen/cardElevation">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cardPadding">

                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/labourRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </android.support.v7.widget.CardView>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cardMarginTop"
                    android:layout_marginBottom="5dp"
                    android:gravity="right"
                    android:orientation="horizontal">


                    <Button
                        android:id="@+id/addLabourButton"
                        android:layout_width="80dp"
                        android:layout_height="25dp"
                        android:background="@drawable/buttonprimaryeffect"
                        android:padding="@dimen/dp5"
                        android:gravity="center|center_vertical"
                        android:text="@string/addMore"
                        android:textSize="10sp"
                        android:textColor="@color/white" />


                </LinearLayout>
            </LinearLayout>


        </android.support.v4.widget.NestedScrollView>
        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/buttonprimaryeffect"
            android:padding="@dimen/dp10"
            android:text="@string/update"
            android:textColor="@color/white" />

    </LinearLayout>


    <TextView
        android:id="@+id/noResultFound"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_results_found"
        android:visibility="gone" />

</FrameLayout>
