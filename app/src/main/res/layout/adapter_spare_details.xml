<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp10"
        android:paddingBottom="@dimen/dp10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.android.theme.font.FontTextView
                android:id="@+id/spareNameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp10"
                android:layout_weight="1"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/sp14" />

            <ImageView
                android:id="@+id/delete"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_delete"
                android:padding="@dimen/dp10" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".7"
                android:gravity="left"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.android.theme.font.FontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/qty"
                        android:textSize="@dimen/sp13" />

                    <com.android.theme.font.FontEdittext
                        android:id="@+id/quantityEditText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:background="@drawable/edittextbggray"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:digits="1234567890."
                        android:maxLength="5"
                        android:minWidth="@dimen/dp50"
                        android:padding="@dimen/dp5"
                        android:singleLine="true"
                        android:text="1"
                        android:textSize="@dimen/sp14" />


                </LinearLayout>

                <com.android.theme.font.FontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp10"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="x"
                    android:textSize="@dimen/sp14" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.android.theme.font.FontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/price"
                        android:textSize="@dimen/sp13" />

                    <com.android.theme.font.FontEdittext
                        android:id="@+id/amountTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/edittextbggray"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:maxLength="9"
                        android:maxLines="1"
                        android:minWidth="@dimen/dp50"
                        android:padding="@dimen/dp5"
                        android:singleLine="true"
                        android:text="@string/qty"
                        android:textSize="@dimen/sp14" />


                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/text_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    android:gravity="center"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/cGSTPercentage"
                            android:textSize="@dimen/sp13" />


                        <com.android.theme.font.FontEdittext
                            android:id="@+id/cGSTPercentageEditText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_marginRight="@dimen/dp10"
                            android:background="@drawable/edittextbggray"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:digits="1234567890."
                            android:maxLines="1"
                            android:minWidth="@dimen/dp50"
                            android:padding="@dimen/dp5"
                            android:singleLine="true"
                            android:text="1"
                            android:textSize="@dimen/sp14" />

                        <com.android.theme.font.FontTextView
                            android:id="@+id/cGSTAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textSize="@dimen/sp13" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">


                        <com.android.theme.font.FontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/sGSTPercentage"
                            android:textSize="@dimen/sp13" />


                        <com.android.theme.font.FontEdittext
                            android:id="@+id/sGSTPercentageEditText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_marginRight="@dimen/dp10"
                            android:background="@drawable/edittextbggray"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:digits="1234567890."
                            android:maxLines="1"
                            android:minWidth="@dimen/dp50"
                            android:padding="@dimen/dp5"
                            android:singleLine="true"
                            android:text="1"
                            android:textSize="@dimen/sp14" />

                        <com.android.theme.font.FontTextView
                            android:id="@+id/sGSTAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textSize="@dimen/sp13" />


                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:orientation="vertical">


            <com.android.theme.font.FontTextView
                android:id="@+id/TotalAmountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:singleLine="true"
                android:text="1"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/sp15" />


        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp5"
        android:background="@color/text_color" />

</LinearLayout>
