<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:theme="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

        <android.support.v7.widget.CardView
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            theme:cardBackgroundColor="@color/app_bg"
            theme:cardCornerRadius="8dp"
            android:layout_margin="5dp"
            android:clickable="true"
            android:foreground="@drawable/ripple_effect"
            theme:cardElevation="2dp"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/reminderTodayLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"

                android:layout_margin="@dimen/dp10"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".7"
                    android:paddingLeft="@dimen/dp5"
                    android:orientation="vertical">

                    <com.android.theme.font.FontTextView
                        android:id="@+id/countTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <com.android.theme.font.FontTextView
                        android:id="@+id/nameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="@string/reminderToday"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp50"
                    android:layout_weight=".3"
                    android:orientation="vertical">


                    <ImageView
                        android:id="@+id/icon"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        android:layout_gravity="right"
                        android:src="@drawable/reminder_today" />

                </LinearLayout>

            </LinearLayout>

        </android.support.v7.widget.CardView>

</LinearLayout>

