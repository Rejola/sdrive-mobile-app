<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/edit_e_corner_bg"
    android:orientation="vertical">

    <com.android.theme.font.FontTextView
        android:id="@+id/noInternetConnection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:foregroundGravity="center"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/title_of_data_message" />

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <ScrollView
            android:id="@id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:id="@+id/digitalLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/imageListLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <android.support.v7.widget.CardView
                        android:id="@+id/imageLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp5"
                        app:cardCornerRadius="@dimen/cardRadius"
                        app:cardElevation="@dimen/cardElevation">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <com.android.theme.font.FontTextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/dp5"
                                android:paddingLeft="@dimen/dp10"
                                android:singleLine="true"
                                android:text="@string/checkInImage"
                                android:textColor="@color/colorPrimary"
                                android:textSize="16sp" />


                            <android.support.v7.widget.RecyclerView

                                android:id="@+id/horizontalRecyclerViewImageList"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp130"
                                android:padding="@dimen/dp10"
                                android:visibility="gone">

                            </android.support.v7.widget.RecyclerView>

                            <com.android.theme.font.FontTextView
                                android:id="@+id/noResultFound"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginBottom="@dimen/dp5"
                                android:visibility="gone" />
                        </LinearLayout>
                    </android.support.v7.widget.CardView>

                </LinearLayout>



                <LinearLayout

                    android:id="@+id/checkListLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <android.support.v7.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp10"
                        app:cardCornerRadius="@dimen/cardRadius"
                        app:cardElevation="@dimen/cardElevation">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/dp10"
                            android:paddingRight="@dimen/dp10">


                            <com.android.theme.font.FontTextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/dp5"
                                android:text="@string/checkList"
                                android:textColor="@color/colorPrimary"
                                android:textSize="16sp" />


                            <LinearLayout

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <com.android.theme.font.FontTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:text="@string/kmsDriven"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="14sp" />


                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/kmsDriven"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="12sp" />

                                </LinearLayout>


                                <android.support.v7.widget.RecyclerView
                                    android:id="@+id/checkRecyclerView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp5"
                                    android:layout_marginBottom="@dimen/dp5"/>


                                <com.android.theme.font.FontTextView
                                    android:id="@+id/noCheckListFound"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp5"
                                    android:text="No Check List Found"
                                    android:textSize="14sp"
                                    android:visibility="gone" />



                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/anyOthersText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:text="@string/anyOthers"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="14sp"
                                        android:visibility="gone"/>


                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/anyOthers"
                                        android:visibility="gone"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:textColor="@color/colorPrimary"
                                        android:layout_marginBottom="@dimen/dp5"
                                        android:textSize="12sp" />





                            </LinearLayout>
                        </LinearLayout>

                    </android.support.v7.widget.CardView>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                   android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    android:visibility="visible">


                    <android.support.v7.widget.CardView
                        android:id="@+id/spareAndLabourLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/cardRadius"
                        app:cardElevation="@dimen/cardElevation"
                        android:visibility="gone"
                        app:cardUseCompatPadding="true">



                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp10"
                            android:layout_marginBottom="@dimen/dp10"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/dp10"
                            android:paddingRight="@dimen/dp10"
                            android:visibility="visible">


                            <com.android.theme.font.FontTextView


                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:singleLine="true"
                                android:text="@string/spareAndLabours"
                                android:textColor="@color/colorPrimary"
                                android:textSize="16sp" />


                            <com.android.theme.font.FontTextView
                                android:id="@+id/noSparesAndLabours"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="@dimen/dp5"
                                android:visibility="gone"
                                android:text="No Spares And Labours Found"/>



                            <LinearLayout
                                android:id="@+id/description1Layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp10"
                                android:orientation="vertical">

                                <!-- <TextView
                                     android:layout_width="match_parent"
                                     android:layout_height="wrap_content"
                                     android:text="@string/description"
                                     android:textColor="@color/textDark"
                                     android:textSize="@dimen/sp14"
                                     android:textStyle="bold" />

                                 <TextView
                                     android:id="@+id/descriptionTextView"
                                     android:layout_width="match_parent"
                                     android:layout_height="wrap_content"
                                     android:singleLine="true"
                                     android:textSize="14sp" />

                                 <TextView
                                     android:layout_width="match_parent"
                                     android:layout_height="wrap_content"
                                     android:layout_weight="1"
                                     android:text="@string/spareLabour"
                                     android:textColor="@color/textDark"
                                     android:textSize="@dimen/sp14"
                                     android:textStyle="bold" />-->


                                <LinearLayout
                                    android:id="@+id/spareLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/spareandlabourbg"
                                    android:orientation="vertical"
                                    android:visibility="gone">


                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:orientation="horizontal"
                                        android:padding="@dimen/dp10"
                                        android:paddingLeft="@dimen/dp10"
                                        android:paddingRight="@dimen/dp10">

                                        <ImageView
                                            android:layout_width="@dimen/dp20"
                                            android:layout_height="@dimen/dp20"
                                            android:layout_gravity="center_vertical"
                                            android:background="@drawable/ic_spares" />

                                        <com.android.theme.font.FontTextView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/dp25"
                                            android:layout_gravity="center"
                                            android:layout_marginLeft="@dimen/dp10"
                                            android:gravity="center_vertical"
                                            android:text="@string/spares"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="16sp" />


                                    </LinearLayout>


                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0.5dp"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:background="@color/text_color" />

                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/noSparesFound"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:padding="@dimen/dp10"
                                        android:text="No Spares Found"
                                        android:textSize="@dimen/sp14"
                                        android:visibility="gone" />

                                    <android.support.v7.widget.RecyclerView

                                        android:id="@+id/spareRecyclerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:layout_marginBottom="@dimen/dp10"
                                        android:visibility="gone" />


                                    <!--  <com.android.theme.font.FontTextView
                                          android:id="@+id/notAvailable1"
                                          android:layout_width="match_parent"
                                          android:layout_height="wrap_content"
                                          android:layout_marginLeft="@dimen/dp10"
                                          android:layout_marginTop="@dimen/dp5"
                                          android:layout_marginRight="@dimen/dp10"
                                          android:layout_marginBottom="@dimen/dp10"
                                          android:text="No Spares Found"
                                          android:textSize="14sp"
                                          android:visibility="gone" />
  -->
                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/labourLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp10"
                                    android:background="@drawable/spareandlabourbg"
                                    android:orientation="vertical"
                                    android:visibility="gone">


                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:orientation="horizontal"
                                        android:padding="@dimen/dp10"
                                        android:paddingLeft="@dimen/dp10"
                                        android:paddingRight="@dimen/dp10">

                                        <ImageView
                                            android:layout_width="@dimen/dp20"
                                            android:layout_height="@dimen/dp20"
                                            android:layout_gravity="center_vertical"
                                            android:background="@drawable/ic_labour" />

                                        <com.android.theme.font.FontTextView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/dp25"
                                            android:layout_gravity="center"
                                            android:layout_marginLeft="@dimen/dp10"
                                            android:gravity="center_vertical"
                                            android:text="@string/labours"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="16sp" />


                                    </LinearLayout>


                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0.5dp"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:background="@color/text_color" />

                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/noLabursFound"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:padding="@dimen/dp10"
                                        android:text="No Labours Found"
                                        android:textSize="@dimen/sp14"
                                        android:visibility="gone" />

                                    <android.support.v7.widget.RecyclerView
                                        android:id="@+id/labourRecyclerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:visibility="gone" />

                                    <!--com.android.theme.font.FontTextView
                                        android:id="@+id/notAvailable2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="@dimen/dp10"
                                        android:layout_marginTop="@dimen/dp5"
                                        android:layout_marginRight="@dimen/dp10"
                                        android:layout_marginBottom="@dimen/dp10"
                                        android:text="No Labours Found"
                                        android:textSize="14sp"
                                        android:visibility="gone" />-->


                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </android.support.v7.widget.CardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="@dimen/dp7"
                    android:layout_marginRight="@dimen/dp7">

                    <android.support.v7.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardUseCompatPadding="true"
                        android:elevation="@dimen/dp4"
                        app:cardCornerRadius="@dimen/cardRadius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/dp10">

                            <com.android.theme.font.FontTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/dateAndTime"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp16" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_weight="1"
                                android:orientation="horizontal">


                                <com.android.theme.font.FontTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight=".5"
                                    android:text="Select Approximate Date"
                                    android:textSize="12sp" />

                                <com.android.theme.font.FontTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="@dimen/dp5"
                                    android:layout_weight=".5"
                                    android:gravity="center"
                                    android:text="Select Approximate Time"
                                    android:textSize="12sp" />
                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_weight="1"
                                android:orientation="horizontal">


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight=".5"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/checkListDateTextView"
                                        android:layout_width="0dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:layout_weight=".4"
                                        android:background="@drawable/edittextbggray"
                                        android:gravity="center"
                                        android:text="Date"
                                        android:textSize="14dp" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:layout_weight=".1"
                                        android:gravity="center">

                                        <ImageView

                                            android:layout_width="@dimen/dp15"
                                            android:layout_height="@dimen/dp20"
                                            android:layout_marginRight="@dimen/dp5"
                                            android:background="@drawable/ic_calendar_new" />
                                    </LinearLayout>


                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="@dimen/dp15"
                                    android:layout_weight=".5"
                                    android:gravity="center"
                                    android:orientation="horizontal"

                                    >

                                    <com.android.theme.font.FontTextView
                                        android:id="@+id/checkListTimeTextView"
                                        android:layout_width="0dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:layout_weight=".4"
                                        android:background="@drawable/edittextbggray"
                                        android:gravity="center"
                                        android:text="Time"
                                        android:textSize="14dp" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_gravity="center"
                                        android:layout_weight=".1"
                                        android:gravity="center">

                                        <ImageView

                                            android:layout_width="@dimen/dp20"
                                            android:layout_height="@dimen/dp20"
                                            android:layout_marginRight="@dimen/dp5"
                                            android:background="@drawable/ic_time_new" />


                                    </LinearLayout>


                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>


                    </android.support.v7.widget.CardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/digitalSignLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="@dimen/dp7"
                    android:layout_marginRight="@dimen/dp7">

                    <android.support.v7.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardUseCompatPadding="true"
                        app:cardCornerRadius="@dimen/cardRadius"
                        app:cardElevation="@dimen/cardElevation">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"

                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="50dp">

                                <com.android.theme.font.FontTextView
                                    android:id="@+id/title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:layout_margin="@dimen/dp10"
                                    android:text="@string/digitalSignature"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="16sp" />


                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_margin="2dp"
                                android:background="@color/text_color" />




                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp110"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">



                                <ImageView
                                    android:visibility="gone"
                                    android:id="@+id/deleteSignature"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:layout_gravity="right"
                                    android:layout_marginTop="@dimen/dp4"
                                    android:layout_marginRight="@dimen/dp10"
                                    android:background="@drawable/ic_delete"/>




                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="visible">

                                    <com.android.theme.font.FontButton
                                        android:id="@+id/clickSignPageButton"
                                        android:layout_width="200dp"
                                        android:layout_height="40dp"
                                        android:padding="@dimen/dp10"
                                        android:paddingLeft="@dimen/dp10"
                                        android:background="@drawable/buttonprimaryeffect"
                                        android:text="@string/clickHereToSign"
                                        android:textAllCaps="false"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/sp16" />

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/signImageView"
                                    android:layout_width="200dp"
                                    android:layout_height="90dp"
                                    android:padding="@dimen/dp5"
                                    android:layout_marginBottom="@dimen/dp5"
                                    android:visibility="gone" />

                            </LinearLayout>

                        </LinearLayout>
                    </android.support.v7.widget.CardView>

                    <LinearLayout
                        android:id="@+id/checkboxLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp30"
                        android:layout_marginTop="@dimen/dp10"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/termsAndConditionCheckbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            android:buttonTint="@color/colorPrimary"
                            android:text=""
                            android:visibility="visible" />

                        <com.android.theme.font.FontTextView
                            android:id="@+id/termsAndConditionTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/termsAndCondition"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp16"
                            android:visibility="visible" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:orientation="horizontal">

                        <com.android.theme.font.FontButton
                            android:id="@+id/updateButtonLayout"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginLeft="60dp"
                            android:layout_marginRight="60dp"
                            android:layout_marginBottom="@dimen/dp10"
                            android:background="@drawable/buttonprimaryeffect"
                            android:text="@string/submit"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp18" />

                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>


        </ScrollView>

    </android.support.v4.widget.NestedScrollView>


</LinearLayout>
